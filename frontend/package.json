{
  "name": "@backio/frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "pnpm --filter @backio/docs build && node scripts/copiar-docs.mjs && next build",
    "start": "next start -p 3000",
    "lint": "next lint && prettier --check . --ignore-path ../.prettierignore",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write . --ignore-path ../.prettierignore"
  },
  "dependencies": {
    "@backio/shared": "workspace:*",
    "@sentry/nextjs": "^11.8.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "canvas-confetti": "1.9.4",
    "next": "15.5.27",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/canvas-confetti": "1.9.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.27",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vitest": "2.1.9"
  }
}
