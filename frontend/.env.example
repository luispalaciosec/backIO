# Frontend de BackIO. Copiar a frontend/.env.local para desarrollo; en producción van en Vercel.
# Todo lo que empieza con NEXT_PUBLIC_ llega al navegador: nunca poner aquí claves secretas.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000

# Opcional: captcha en login y recuperar contraseña (Cloudflare Turnstile, clave del sitio).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Opcional: errores del navegador y del servidor de Next a Sentry (proyecto backio-frontend).
NEXT_PUBLIC_SENTRY_DSN=
