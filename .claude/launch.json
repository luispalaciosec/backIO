{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@backio/backend",
        "dev"
      ],
      "port": 4000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@backio/frontend",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "frontend-prod",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@backio/frontend",
        "start"
      ],
      "port": 3000
    }
  ]
}
