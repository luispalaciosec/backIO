{
  "name": "@backio/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:push": "supabase db push",
    "db:seed": "supabase db reset --linked",
    "lint": "eslint src && prettier --check src --ignore-path ../.prettierignore",
    "format": "prettier --write src --ignore-path ../.prettierignore",
    "db:types": "tsx scripts/gen_tipos_db.ts && prettier --write src/lib/db/database.types.ts",
    "docs:api": "tsx scripts/gen_docs_api.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@backio/shared": "workspace:*",
    "@hono/node-server": "^1.13.7",
    "@hono/zod-validator": "^0.9.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@sentry/node": "^11.9.0",
    "@supabase/supabase-js": "^2.118.0",
    "hono": "^4.13.14",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "dotenv": "^18.0.9",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
