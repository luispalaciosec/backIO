{
  "name": "@backio/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:push": "supabase db push",
    "db:seed": "supabase db reset --linked",
    "lint": "eslint src && prettier --check src --ignore-path ../.prettierignore",
    "format": "prettier --write src --ignore-path ../.prettierignore"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.0",
    "@backio/shared": "workspace:*",
    "@hono/node-server": "^1.13.7",
    "@hono/zod-validator": "^0.9.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@supabase/supabase-js": "^2.117.3",
    "hono": "^4.13.13",
    "tsx": "^4.23.15",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "dotenv": "^18.0.7",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
