# Backend de BackIO. Copiar a backend/.env para desarrollo; en producción van en Railway (servicio @backio/backend).
# Nunca commitear valores reales.

# ---- Supabase (obligatorias) ----
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service role: salta RLS. Solo en el servidor, jamás en el frontend.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Servidor ----
# Puerto local (Railway inyecta PORT y tiene prioridad).
BACKEND_PORT=4000
# URL pública del backend (https en producción): emisor OAuth y URL del webhook de Basecamp.
BACKEND_PUBLIC_URL=
# Orígenes del frontend admitidos por CORS, separados por coma (https en producción; sin localhost).
FRONTEND_URL=http://localhost:3000
# development | test | production
NODE_ENV=development
# debug | info | warn | error (por defecto info en producción, debug en desarrollo).
LOG_LEVEL=
# 1 = corre los jobs dentro del proceso (lib/jobs.ts). El Dockerfile ya lo fija.
ENABLE_INTERNAL_CRON=
# Secreto para disparar /api/cron desde fuera. Sin él, en producción esos endpoints responden 401.
CRON_SECRET=

# ---- Basecamp ----
BASECAMP_CLIENT_ID=
BASECAMP_CLIENT_SECRET=
BASECAMP_ACCOUNT_ID=
BASECAMP_REDIRECT_URI=
BASECAMP_USER_AGENT=BackIO Geeks (correo@dominio)
# Va en la URL del webhook registrado en Basecamp. Si se rota, pulsar «Actualizar webhooks» en Admin → Integraciones.
BASECAMP_WEBHOOK_SECRET=

# ---- PrometIO ----
PROMETIO_WEBHOOK_SECRET=
# Solo para el chequeo de salud de Admin → Servicios.
PROMETIO_URL=

# ---- IA (opcional: sin clave, las funciones de IA se ocultan) ----
ANTHROPIC_API_KEY=

# ---- Correo (opcional: sin clave, los correos no salen y queda aviso en el log) ----
RESEND_API_KEY=
EMAIL_FROM=BackIO <no-reply@dominio>

# ---- Turnstile (opcional: sin clave no se pide captcha) ----
TURNSTILE_SECRET_KEY=

# ---- Sentry (opcional: sin DSN no se envía nada) ----
SENTRY_DSN=
